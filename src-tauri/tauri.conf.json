{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guarded Upgrade Path",
  "version": "0.1.0",
  "identifier": "org.guardedupgradepath.review",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Guarded Upgrade Path — review sandbox",
        "width": 1480,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "Interactive technical review sandbox for the Guarded Upgrade Path review draft",
    "longDescription": "A review aid that runs a deterministic local model of the proposal, approval and execution split described in the Guarded Upgrade Path review draft. Offline; no chain, no keys, no production data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Logos & Co",
    "copyright": "© 2026 Logos & Co"
  }
}
